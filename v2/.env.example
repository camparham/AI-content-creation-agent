# Copy to .env and fill in your values:
#   cp .env.example .env

# Required — research and content generation
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional — research report length
# Presets:
#   brief    — 800-1200 words,  3000 tokens
#   normal   — 1500-2000 words, 5000 tokens (default)
#   long     — 2500-3500 words,  8000 tokens
#   extended — 3500-5000 words, 16000 tokens
OUTPUT_LENGTH=normal

# Optional — Google Sheets pipeline (also needs service-account.json in project root)
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=

# Optional — HeyGen video generation
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
